{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sim-civics",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-29",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_destination_addresses": [
				"simcivics@gmail.com"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sim-civics",
			"database_id": "94e5137a-ef8d-4535-a7c3-07e18929b709",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}