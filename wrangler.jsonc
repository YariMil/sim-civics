{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sim-civics",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-29",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_destination_addresses": [
				"simcivics@gmail.com"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sim-civics",
			"database_id": "94e5137a-ef8d-4535-a7c3-07e18929b709",
			"migrations_dir": "migrations"
		}
	],
	// Branch previews (`wrangler preview`) use a separate test database so they never touch real accounts.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "sim-civics-preview",
				"database_id": "53095f7e-3e3a-4c02-8ef9-bd211f89a07b",
				"migrations_dir": "migrations"
			}
		],
		"send_email": [
			{
				"name": "EMAIL",
				"allowed_destination_addresses": [
					"simcivics@gmail.com"
				]
			}
		]
	},
	"observability": {
		"enabled": true
	}
}